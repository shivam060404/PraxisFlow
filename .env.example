# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql://ami:ami_dev_password@localhost:5432/ami

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ami_dev_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ami
MINIO_SECRET_KEY=ami_dev_password
MINIO_BUCKET_AUDIO=meeting-audio
MINIO_BUCKET_TRANSCRIPTS=meeting-transcripts

# Deepgram ASR
DEEPGRAM_API_KEY= 

# Groq (Llama 3.3 70B)
GROQ_API_KEY= 

# OpenAI (Embeddings + Judge)
OPENAI_API_KEY=
# JWT / Auth
JWT_SECRET=dev_secret_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Clerk
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Deepgram Options
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en
DEEPGRAM_DIARIZE=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_PARAGRAPHS=true

# Live transcript relay (disabled unless explicitly enabled and keyed)
LIVE_TRANSCRIPT_ENABLED=false
LIVE_TRANSCRIPT_MAX_BUFFER_BYTES=4194304
LIVE_TRANSCRIPT_MAX_CHUNK_BYTES=262144
LIVE_TRANSCRIPT_QUEUE_SIZE=64
LIVE_TRANSCRIPT_IDLE_TIMEOUT_SECONDS=30

# LLM Settings
EXTRACTION_MODEL=llama-3.3-70b-versatile
EXTRACTION_TEMPERATURE=0.1
VERIFICATION_MODEL=llama-3.3-70b-versatile
VERIFICATION_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# Chunking
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Verification Thresholds
VERIFICATION_FAITHFULNESS_THRESHOLD=0.7
VERIFICATION_HALLUCINATION_THRESHOLD=0.1
VERIFICATION_COMPLETENESS_THRESHOLD=0.6

# Entity Resolution
ENTITY_RESOLUTION_MIN_CONFIDENCE=0.6
NAME_MATCH_THRESHOLD=80

# Deduplication
DEDUP_SIMILARITY_THRESHOLD=0.92

# RAG
RAG_ENABLED=false
RAG_TOP_K=10
RAG_RECENCY_BOOST_DAYS=30
RAG_COLLECTION_NAME=meeting_intelligence
RAG_SCORE_THRESHOLD=0.65
RAG_MAX_CONTEXT_CHARS=12000

# File Upload
MAX_FILE_SIZE_MB=500
ALLOWED_AUDIO_TYPES=["audio/mpeg", "audio/wav", "audio/mp4", "audio/webm", "audio/x-m4a"]

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Native notification delivery and signed HITL action links
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_TLS=true
NOTIFICATION_FROM_EMAIL=notifications@example.com
NOTIFICATION_ACTION_SECRET=replace-with-a-random-secret
NOTIFICATION_ACTION_BASE_URL=http://localhost:8000/api/v1/notifications/actions
NOTIFICATION_ACTION_TTL_SECONDS=604800
# Calendar OAuth (inject production values from a secret manager)
CALENDAR_OAUTH_STATE_SECRET=replace-with-random-state-secret
CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key-or-secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/slack/callback
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/teams/callback

# Customer-managed encryption and residency
AWS_REGION=us-east-1
KMS_REQUIRED_FOR_TENANT_DATA=false

# Cost analytics projection (optional in development)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=praxisflow
CLICKHOUSE_USAGE_TABLE=llm_usage