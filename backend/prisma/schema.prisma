generator client {
  provider = "prisma-client-py"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant Isolation ───
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  status    String   @default("active")
  dataRegion String  @default("us")
  kmsKeyArn String?
  retentionDays Int  @default(2555)
  recordingConsentRequired Boolean @default(true)
  phiProcessingEnabled Boolean @default(false)
  monthlyLlmBudgetUsd Float @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  meetings     Meeting[]
  integrations Integration[]
  tasks        Task[]
  taskOutbox   TaskOutbox[]
  webhookEvents IntegrationWebhookEvent[]
  dataSubjectRequests  DataSubjectRequest[]
  complianceExports    ComplianceExport[]
  aiAuditLogs  AiAuditLog[]
  calendars    CalendarConnection[]
  captures     MeetingCapture[]
  calendarEvents CalendarEvent[]
  notificationDeliveries NotificationDelivery[]
  llmUsageRecords LLMUsageRecord[]

  @@index([slug])
}

// ─── Users & Identity ───
model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  fullName     String
  avatarUrl    String?
  role         String   @default("member")
  status       String   @default("ACTIVE") // INVITED | ACTIVE | SUSPENDED | DELETED
  deletedAt    DateTime?
  clerkUserId  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  attendees    Attendee[]
  assignedTasks Task[]    @relation("Assignee")
  resolvedFlags MeetingFlag[] @relation("ResolvedFlags")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([clerkUserId])
}

// ─── Meetings ───
model Meeting {
  id              String        @id @default(uuid())
  tenantId        String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int?
  status          MeetingStatus @default(UPLOADED)
  audioUrl        String?
  recordingSource String        @default("upload")
  calendarEventId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  attendees  Attendee[]
  transcript Transcript?
  tasks      Task[]
  flags      MeetingFlag[]
  aiAuditLogs AiAuditLog[]
  captures MeetingCapture[]
  calendarEvent CalendarEvent?
  consentStatus String @default("unknown")
  notificationDeliveries NotificationDelivery[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
}

enum MeetingStatus {
  SCHEDULED
  CAPTURING
  UPLOADED
  PROCESSING
  TRANSCRIBED
  EXTRACTED
  COMPLETED
  ERROR
}

model CalendarConnection {
  id              String                    @id @default(uuid())
  tenantId        String
  provider        CalendarProvider
  externalAccount String
  accessTokenRef  String                    @db.Text
  refreshTokenRef String?                   @db.Text
  tokenExpiresAt  DateTime?
  syncCursor      String?
  status          CalendarConnectionStatus   @default(ACTIVE)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@unique([tenantId, provider, externalAccount])
  @@index([tenantId, status])
}

model CalendarEvent {
  id              String   @id @default(uuid())
  tenantId        String
  connectionId    String
  externalEventId String
  meetingId       String?  @unique
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int?
  organizerEmail  String?
  joinUrl         String?
  status          String   @default("confirmed")
  rawPayload      Json?
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  meeting    Meeting?           @relation(fields: [meetingId], references: [id])

  @@unique([connectionId, externalEventId])
  @@index([tenantId, scheduledAt])
}

enum CalendarProvider {
  google
  microsoft
}

enum CalendarConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
}

model NotificationDelivery {
  id            String              @id @default(uuid())
  tenantId      String
  meetingId     String
  channel       NotificationChannel
  recipient     String
  status        NotificationStatus   @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now())
  lastAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?             @db.Text
  idempotencyKey String             @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, meetingId])
}

enum NotificationChannel {
  email
  slack
  teams
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

// ─── Ambient meeting capture lifecycle ───
// The vendor bot is intentionally represented as an external resource. This
// keeps Recall.ai/Fireflies-specific APIs outside the core meeting domain.
model MeetingCapture {
  id              String              @id @default(uuid())
  tenantId        String
  meetingId       String
  provider        CaptureProvider
  externalBotId   String
  status          CaptureStatus       @default(SCHEDULED)
  scheduledFor    DateTime?
  attempts        Int                 @default(0)
  lastAttemptAt   DateTime?
  recordingUrl    String?
  startedAt       DateTime?
  endedAt         DateTime?
  lastEventAt     DateTime?
  webhookSecret   String
  rawPayload      Json?
  errorMessage    String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([provider, externalBotId])
  @@index([tenantId, status])
  @@index([meetingId])
}

enum CaptureProvider {
  recall
  fireflies
}

enum CaptureStatus {
  SCHEDULING
  SCHEDULED
  JOINING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// ─── Attendees ───
model Attendee {
  id             String   @id @default(uuid())
  meetingId      String
  userId         String?
  email          String
  displayName    String
  speakerLabel   String?
  responseStatus String   @default("accepted")
  createdAt      DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([meetingId, email])
  @@index([meetingId])
}

// ─── Transcripts ───
model Transcript {
  id           String   @id @default(uuid())
  meetingId    String   @unique
  fullText     String   @db.Text
  language     String   @default("en")
  wordCount    Int      @default(0)
  durationMs   Int      @default(0)
  processedAt  DateTime @default(now())
  redactionApplied Boolean @default(false)

  meeting  Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  utterances Utterance[]

  @@index([meetingId])
}

model Utterance {
  id              String   @id @default(uuid())
  transcriptId    String
  speakerLabel    String
  text            String   @db.Text
  startTimeMs     Int
  endTimeMs       Int
  confidence      Float?
  wordStartIdx    Int?
  wordEndIdx      Int?
  hasRedactions   Boolean  @default(false)
  redactionMap    Json?

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, wordStartIdx])
  @@index([transcriptId, startTimeMs])
}

// ─── Tasks (Extracted Action Items) ───
model Task {
  id                  String        @id @default(uuid())
  tenantId            String
  meetingId           String
  title               String
  description         String        @db.Text
  taskType            TaskType
  status              TaskStatus    @default(EXTRACTED)
  priority            String?

  // Assignee resolution
  assigneeHint        String?
  assigneeId          String?
  assigneeResolvedBy  String?

  // Deadline resolution
  deadlineHint        String?
  deadlineDate        DateTime?
  deadlineResolvedBy  String?

  // Transcript provenance
  transcriptWordStart Int
  transcriptWordEnd   Int
  sourceQuote         String        @db.Text

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationReasoning String?     @db.Text
  extractionConfidence Float

  // Integration sync
  externalId          String?
  externalUrl         String?
  integrationId       String?
  lastSyncedAt        DateTime?
  syncStatus          SyncStatus?

  // Metadata
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdBy           String        @default("ai_agent")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting    Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee   User?        @relation("Assignee", fields: [assigneeId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])
  auditLogs  TaskAuditLog[]
  aiAuditLogs AiAuditLog[]
  outboxEvents TaskOutbox[]

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([meetingId, taskType])
  @@index([assigneeId, status])
  @@index([externalId, integrationId])
}

enum TaskType {
  ACTION_ITEM
  DECISION
  FOLLOW_UP
  BLOCKER
}

enum TaskStatus {
  EXTRACTED
  PENDING_REVIEW
  VERIFIED
  ASSIGNED
  SYNCED
  SYNC_FAILED
  CONFLICT
  COMPLETED
  DISMISSED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  NEEDS_REVIEW
  FAILED
}

enum SyncStatus {
  PENDING
  SYNCED
  SYNC_FAILED
  CONFLICT
}

// ─── Task State Machine Audit Log ───
model TaskAuditLog {
  id             String     @id @default(uuid())
  taskId         String
  previousStatus TaskStatus?
  newStatus      TaskStatus
  changedBy      String
  reason         String?    @db.Text
  metadata       Json?
  createdAt      DateTime   @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ─── Integrations ───
model Integration {
  id            String            @id @default(uuid())
  tenantId      String
  provider      IntegrationProvider
  displayName   String
  status        String            @default("ACTIVE")
  config        Json              @default("{}")
  webhookSecret String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  Task[]
  outboxEvents TaskOutbox[]
  webhookEvents IntegrationWebhookEvent[]

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// ─── Durable inbound integration webhooks ───
// The provider request is acknowledged only after this record is committed.
// Processing is asynchronous and idempotent so provider retries are safe.
model IntegrationWebhookEvent {
  id             String              @id @default(uuid())
  tenantId       String
  integrationId  String
  provider       IntegrationProvider
  deliveryKey    String
  externalId     String?
  externalStatus String?
  externalUrl    String?
  changedAt      DateTime?
  payload        Json
  status         WebhookEventStatus  @default(PENDING)
  attempts       Int                 @default(0)
  availableAt    DateTime            @default(now())
  lockedAt       DateTime?
  processedAt    DateTime?
  lastError      String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, deliveryKey])
  @@index([status, availableAt])
  @@index([tenantId, createdAt])
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

// ─── Transactional integration outbox ───
// Records are created in the same transaction as the local task mutation.
// The relay may deliver an event more than once; idempotencyKey prevents
// duplicate enqueueing and adapters must remain safe to retry.
model TaskOutbox {
  id             String          @id @default(uuid())
  tenantId       String
  taskId         String
  integrationId  String
  eventType      TaskOutboxEvent @default(CREATE)
  status         OutboxStatus    @default(PENDING)
  attempts       Int             @default(0)
  availableAt    DateTime        @default(now())
  lockedAt       DateTime?
  processedAt    DateTime?
  lastError      String?         @db.Text
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([taskId, integrationId, eventType])
  @@index([status, availableAt])
  @@index([tenantId, status])
}

enum TaskOutboxEvent {
  CREATE
  UPDATE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
}

enum IntegrationProvider {
  jira
  asana
  linear
  slack
  teams
  github
  salesforce
  notion
}

// ─── AI Audit Logs ───
model AiAuditLog {
  id                 String   @id @default(uuid())
  tenantId           String
  taskId             String?
  meetingId          String?
  decisionType       String
  model              String
  promptTokens       Int?
  completionTokens   Int?
  rawInputHash       String?
  rawOutput          String?
  structuredOutput   Json?
  verificationResult Json?
  latencyMs          Int?
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id])
  meeting Meeting? @relation(fields: [meetingId], references: [id])

  @@index([tenantId, createdAt])
  @@index([taskId])
  @@index([meetingId])
}

model LLMUsageRecord {
  id              String   @id @default(uuid())
  // Stable request correlation key. Retries must not create a second ledger row.
  correlationId   String?  @unique
  tenantId        String
  userId          String?
  meetingId       String?
  pipelineRunId   String?
  pipelineNode    String
  provider        String
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  costUsd         Float    @default(0)
  cached          Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, model, createdAt])
  @@index([meetingId])
}

// ─── Meeting Flags ───
model MeetingFlag {
  id          String   @id @default(uuid())
  meetingId   String
  flagType    String
  message     String   @db.Text
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  resolver  User?   @relation("ResolvedFlags", fields: [resolvedBy], references: [id])

  @@index([meetingId])
}
// ─── GDPR Data Subject Requests ───
model DataSubjectRequest {
  id                      String   @id @default(uuid())
  tenantId                String
  requestType             String   // access | rectification | erasure | portability | restriction | objection
  dataSubjectId           String?  // User id, when resolvable in this tenant
  dataSubjectEmail        String
  status                  String   @default("pending") // pending | in_progress | completed | rejected | extended
  reason                  String?  @db.Text
  specificDataCategories  Json?
  responseData            Json?
  completedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// ─── GDPR Art. 20 Compliance Exports ───
model ComplianceExport {
  id          String    @id @default(uuid())
  tenantId    String
  format      String    @default("json") // json | csv | pdf
  status      String    @default("pending") // pending | completed | failed
  downloadUrl String?
  error       String?   @db.Text
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
